# Bu dosya repoda durur ve hangi değişkenlerin gerektiğini anlatır.
# Gerçek değerler .env'de (gitignore'lu) — sırlar asla repoya girmez.

NODE_ENV=development
PORT=3000

# Postgres
# Docker Compose'daki postgres servisiyle aynı kimlik bilgileri.
DATABASE_URL="postgresql://cardraft:cardraft@localhost:5432/cardraft?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — üretimde MUTLAKA farklı, uzun ve rastgele değerler
# (üretmek için: openssl rand -base64 48)
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-please
# Access kısa ömürlü: çalınırsa zarar penceresi dar olsun.
JWT_ACCESS_TTL=15m
# Refresh uzun ömürlü ama rotasyonlu ve DB'den iptal edilebilir.
JWT_REFRESH_TTL=30d

# E-postadaki doğrulama/sıfırlama bağlantılarının kökü. Varsayılan uygulamanın
# derin bağlantı şeması; web sayfası eklenirse https adresi yazılır.
APP_LINK_BASE_URL="cardraft://"
