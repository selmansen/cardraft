/// E-posta doğrulama ve şifre sıfırlama için tek kullanımlık jetonlar.
///
/// İki ayrı tablo yerine tek tablo + `purpose`: ikisinin alanları birebir aynı
/// (hash, son kullanma, kullanıldı mı) ve ikisinin kuralları da aynı — tek
/// kullanımlık, süreli, hash'li. Ayrı tablolar aynı mantığın iki kopyasını
/// doğurur ve biri düzeltildiğinde diğeri unutulur.
enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Jetonun KENDİSİ değil hash'i saklanıyor — refresh token'larla aynı gerekçe:
/// veritabanı sızarsa düz metin jeton doğrudan hesap devralmaya yarar.
model AuthToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   TokenPurpose
  /// SHA-256(jeton). Yüksek entropili rastgele dize olduğu için argon2'ye
  /// gerek yok (şifre gibi tahmin edilebilir değil).
  tokenHash String       @unique

  expiresAt DateTime
  /// Tek kullanımlık: kullanıldığı an damgalanıyor. Silmek yerine
  /// damgalamak, "bu bağlantı zaten kullanıldı" diyebilmek için.
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Harici kimlik sağlayıcıları (Apple, Google).
///
/// TABLO ŞİMDİDEN VAR ama henüz hiçbir sağlayıcı bağlı değil. Sebebi: bir
/// kullanıcının birden fazla giriş yolu olabilmesi (e-posta + Apple) ilişkisel
/// olarak "bir kullanıcı, çok kimlik" demek. Bunu sonradan eklemek, User
/// tablosuna providerId kolonları serpiştirip sonra ayıklamak olurdu.
///
/// iOS'ta üçüncü taraf girişi sunan uygulamanın Apple ile Giriş'i de sunması
/// App Store kuralı; o yüzden Google eklenirse Apple da eklenecek.
enum IdentityProvider {
  APPLE
  GOOGLE
}

model UserIdentity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider IdentityProvider
  /// Sağlayıcının verdiği kalıcı kullanıcı kimliği ("sub" iddiası).
  subject  String
  /// Sağlayıcının bildirdiği e-posta — Apple gizli röle adresi verebiliyor,
  /// bu yüzden User.email ile aynı olmak zorunda değil.
  email    String?

  createdAt DateTime @default(now())

  /// Aynı sağlayıcı hesabı iki kullanıcıya bağlanamaz.
  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}
