                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "if (json.installationId) {",
                  "  pm.collectionVariables.set('installationId', json.installationId);",
                  "}",
                  "pm.test('Oturum açıldı', () => {",
