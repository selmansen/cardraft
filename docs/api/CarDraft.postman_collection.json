            "body": {
              "mode": "raw",
              "raw": "{\n  \"installationId\": \"{{installationId}}\",\n  \"platform\": \"IOS\",\n  \"appVersion\": \"0.1.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
