  "info": {
    "title": "CarDraft API",
    "description": "Araç temalı koleksiyon kart oyununun sunucu API'si.\n\n**Başlarken:** `POST /auth/guest` ile misafir oturumu aç, dönen\n`accessToken`'ı yukarıdaki **Authorize** düğmesine yapıştır.\n\nUç noktalar varsayılan olarak **kapalıdır**: guard global, açmak için\naçıkça `@Public()` yazmak gerekir. Kilit simgesi olmayan uçlar kimlik\ndoğrulaması istemez.\n\nKararların gerekçeleri `server/docs/adr/` altında.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Sistem",
      "description": "Kimlik doğrulaması istemeyen uçlar"
    },
    {
      "name": "Kimlik",
      "description": "Misafir giriş, kayıt, token yenileme"
    },
    {
      "name": "Ekonomi",
      "description": "Cüzdan ve işlem defteri"
    },
    {
      "name": "Envanter",
      "description": "Koleksiyon ve kart açma"
    },
    {
      "name": "Maç",
      "description": "Maç oturumu ve sunucu tarafı doğrulama"
    },
    {
      "name": "Cihaz",
      "description": "Cihaz kaydı ve push jetonları"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {}
      },
      "GuestLoginDto": {
        "type": "object",
        "properties": {}
      },
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LinkAccountDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          },
          "displayName": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "token"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 200
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Misafir hesapta şifre yok; o yüzden opsiyonel.",
            "maxLength": 200
          }
        }
      },
      "UnlockCardDto": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "currency": {
            "type": "string",
            "description": "Hangi keseden ödeneceği. Zorunlu — varsayılan vermek tehlikeli olurdu:\nistemcinin niyetini tahmin edip yanlış para birimini harcamak,\nkullanıcının geri alamayacağı bir hata.",
            "enum": [
              "COIN",
              "RIM"
            ]
          }
        },
        "required": [
