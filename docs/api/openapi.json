  "info": {
    "title": "CarDraft API",
    "description": "Araç temalı koleksiyon kart oyununun sunucu API'si.\n\n**Başlarken:** `POST /auth/guest` ile misafir oturumu aç, dönen\n`accessToken`'ı yukarıdaki **Authorize** düğmesine yapıştır.\n\nUç noktalar varsayılan olarak **kapalıdır**: guard global, açmak için\naçıkça `@Public()` yazmak gerekir. Kilit simgesi olmayan uçlar kimlik\ndoğrulaması istemez.\n\nKararların gerekçeleri `server/docs/adr/` altında.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Sistem",
      "description": "Kimlik doğrulaması istemeyen uçlar"
    },
    {
      "name": "Kimlik",
      "description": "Misafir giriş, kayıt, token yenileme"
    },
    {
      "name": "Ekonomi",
      "description": "Cüzdan ve işlem defteri"
    },
    {
      "name": "Envanter",
      "description": "Koleksiyon ve kart açma"
    },
    {
      "name": "Maç",
      "description": "Maç oturumu ve sunucu tarafı doğrulama"
    },
    {
      "name": "Cihaz",
      "description": "Cihaz kaydı ve push jetonları"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {}
      },
      "GuestLoginDto": {
        "type": "object",
        "properties": {}
      },
      "ProviderSignInDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "APPLE",
              "GOOGLE"
            ]
          },
          "idToken": {
            "type": "string",
            "description": "Sağlayıcının döndürdüğü imzalı kimlik jetonu (JWT).",
            "minLength": 20,
            "maxLength": 4096
          },
          "installationId": {
            "type": "string",
            "description": "Uygulamanın o cihazdaki kurulumunu tanımlayan kimlik. İstemci üretir\n(expo-application / kendi ürettiği uuid) ve saklar. Donanım kimliği\nDEĞİL: iOS kalıcı donanım kimliği vermiyor, zorlamak da mağaza\npolitikalarıyla sorun yaratır.",
            "minLength": 8,
            "maxLength": 128
          },
          "platform": {
            "type": "string",
            "enum": [
              "IOS",
              "ANDROID"
            ]
          },
          "appVersion": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "provider",
          "idToken",
          "installationId",
          "platform"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "APPLE",
              "GOOGLE"
            ]
          },
          "idToken": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "UnlockCardDto": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "currency": {
            "type": "string",
            "description": "Hangi keseden ödeneceği. Zorunlu — varsayılan vermek tehlikeli olurdu:\nistemcinin niyetini tahmin edip yanlış para birimini harcamak,\nkullanıcının geri alamayacağı bir hata.",
            "enum": [
              "COIN",
              "RIM"
            ]
          }
        },
        "required": [
          "cardId",
          "currency"
        ]
      },
      "OpenMatchDto": {
        "type": "object",
        "properties": {
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "normal",
              "hard"
            ]
          },
          "vehicleCardIds": {
            "description": "Oyuncunun bu maç için seçtiği araçlar. Seçim istemcinin, ama her\n kimliğin gerçekten sahip olunan bir karta karşılık geldiği sunucuda\n doğrulanıyor (MatchService.open).",
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supportCardIds": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "difficulty",
          "vehicleCardIds",
          "supportCardIds"
        ]
      },
      "PlayerActionDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "PLAY",
              "PLAY_SUPPORT",
              "ATTACK"
            ]
          },
          "handIndex": {
            "type": "number",
            "minimum": 0
          },
          "scrapUid": {
            "type": "string",
            "maxLength": 64
          },
          "targetUid": {
            "type": "string",
            "maxLength": 64
          },
          "attackerUid": {
            "type": "string",
            "maxLength": 64
          },
          "target": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "type"
        ]
      },
      "PlayerTurnDto": {
        "type": "object",
        "properties": {
          "actions": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerActionDto"
            }
          }
        },
        "required": [
          "actions"
        ]
      },
      "SubmitMatchDto": {
        "type": "object",
        "properties": {
          "turns": {
            "maxItems": 60,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerTurnDto"
            }
          }
        },
        "required": [
          "turns"
        ]
      },
      "OpenPackDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "İstemcinin ürettiği tekrar koruması.\n\nZorunlu ve istemciden geliyor çünkü korunması gereken şey tam olarak\n\"aynı isteğin ikinci kez gönderilmesi\": mobil ağda cevap kaybolur,\nistemci tekrar dener. Sunucu kendi kimliğini üretseydi her deneme yeni\nbir açılış olurdu — oyuncudan iki kez para düşer, iki kart çekilirdi.\n\nUUID şartı bilinçli: tahmin edilemez ve çakışmaz. Sıra numarası\nolsaydı bir oyuncunun kimliği bir başkasınınkiyle çakışabilirdi\n(benzersizlik kullanıcı başına ama yine de öngörülebilirlik istemiyoruz).",
            "format": "uuid"
          }
        },
        "required": [
          "requestId"
        ]
      }
    }
  }
}
